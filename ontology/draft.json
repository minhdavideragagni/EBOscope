  "examples": [
    {
      "id": "mercator",
      "title": "Mercator and comparison of territorial areas",
      "summary": "A geography educator assesses a classroom Mercator map for comparing territorial areas. The criterion is representational adequacy for this purpose, the indicator is area distortion, and the qualification concerns this map in this use.",
      "qualification": "This classroom map is unsuitable for comparing the relative areas of territories."
    },
    {
      "id": "debias",
      "title": "DE-BIAS and contextual terminology",
      "summary": "A cataloguer reviews a current catalogue description presenting a community as 'primitive'. The assessment concerns an unsupported cultural hierarchy and keeps a current catalogue use distinct from a historical quotation.",
      "qualification": "This description presents an unsupported cultural hierarchy as a factual classification."
    },
    {
      "id": "rupe-magna",
      "title": "Rupe Magna and scope of generalisation",
      "summary": "An archaeologist reviews whether an RTI sample selected for technical quality supports claims about the full iconographic diversity of a rock surface. The qualification records that representativeness has not been established.",
      "qualification": "Representativeness for the full iconographic diversity of Rupe Magna has not been established; surface-wide generalisations require further evidence."
    }
