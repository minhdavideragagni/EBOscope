{
  "status": "draft",
  "title": "Epistemic Bias Ontology (EBO) — draft conceptual model",
  "authoritative_owl": null,
  "note": "This file represents the supplied draft conceptual model for EBOscope v2. It is not the authoritative EBO OWL and does not claim final axioms or IRIs.",
  "description": "The Epistemic Bias Ontology (EBO) is being developed as the interface for representing epistemic bias within the INFINITY ontology network. It represents the assessment through which a limitation becomes epistemically relevant, including the entity examined, the responsible agent, the assessment method, criteria and evidence, and the resulting qualification. Bias assessments are therefore attributable, contextualised and open to revision as evidence or intended uses change.",
  "conceptual_grounding": [
    {
      "label": "Bueter (2022)",
      "role": "Epistemic account of bias; distinguishing biased from legitimately value-laden research through reasons to suspect research could have been systematically better."
    },
    {
      "label": "Ferrario et al. (2025)",
      "role": "Relational and norm-sensitive view of bias; the same outcome may be biased relative to one standard but not another."
    },
    {
      "label": "Doc-BiasO — Russo & Vidal (2025)",
      "role": "Complementary machine-readable documentation of bias in ML pipelines; EBO keeps indicators/evidence distinct from the qualification itself."
    },
    {
      "label": "Gangemi & Presutti (2022)",
      "role": "Cognitive Perspectivisation pattern reused to model conceptualiser, background, lens, attitude and cut without equating perspective with bias."
    }
  ],
